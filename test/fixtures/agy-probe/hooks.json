{
  "probe-pre-json": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/probe.mjs pre-json",
            "timeout": 10
          }
        ]
      }
    ]
  },
