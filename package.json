{
  "name": "agy-plugin-porter",
  "version": "0.1.0",
  "description": "Ports Claude Code, Gemini CLI, Cursor, Roo/Kilo and Codex plugins to native Antigravity plugins.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Arthur Cavallari",
    "url": "https://github.com/arthurcavallari"
  },
  "homepage": "https://github.com/arthurcavallari/agy-plugin-porter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurcavallari/agy-plugin-porter.git"
  },
  "bugs": {
    "url": "https://github.com/arthurcavallari/agy-plugin-porter/issues"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "agy",
    "agy-plugin",
    "antigravity-plugin",
    "claude-code",
    "claude-code-plugin",
    "gemini-cli",
    "cursor",
    "roo-code",
    "codex",
    "plugin-porter",
    "hooks",
    "mcp"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "agy-porter": "bin/agy-porter.mjs"
  },
  "optionalDependencies": {
    "esbuild": "0.28.2"
  },
  "files": [
    "bin",
    "lib",
    "scripts/hook-shim.mjs",
    "scripts/mod-runtime",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./consent": "./lib/consent.mjs",
    "./detector": "./lib/detector.mjs",
    "./hook-compiler": "./lib/hook-compiler.mjs",
    "./manifest-sanitizer": "./lib/manifest-sanitizer.mjs",
    "./mod-compiler": "./lib/mod-compiler.mjs",
    "./skill-compiler": "./lib/skill-compiler.mjs",
    "./rules-compiler": "./lib/rules-compiler.mjs",
    "./mode-compiler": "./lib/mode-compiler.mjs",
    "./static-auditor": "./lib/static-auditor.mjs",
    "./transpiler-engine": "./lib/transpiler-engine.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/yaml-lite.test.mjs test/detector.test.mjs test/hook-compiler.test.mjs test/hook-shim.test.mjs test/compilers.test.mjs test/transpiler.test.mjs test/mod-scan.test.mjs test/mod-compiler.test.mjs test/mod-continuation.test.mjs test/mod-runtime.test.mjs test/mod-stage.test.mjs test/mod-e2e.test.mjs test/consent.test.mjs test/session-start.test.mjs test/plugin-build.test.mjs test/plugin-mcp.test.mjs test/cockpit.test.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "build:plugin": "node scripts/build-plugin.mjs"
  }
}
